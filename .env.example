# Configuration de l'application AIMGPT

# ============================
# API KEYS
# ============================

# Clé API OpenAI pour accéder aux modèles GPT
# Obtenir une clé : https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================
# CONFIGURATION MODELE
# ============================

# Modèle à utiliser (gpt-4, gpt-3.5-turbo, etc.)
MODEL=gpt-3.5-turbo

# Température (0.0 = déterministe, 1.0 = créatif)
TEMPERATURE=0.7

# Nombre maximum de tokens pour les réponses
MAX_TOKENS=2000

# ============================
# CONFIGURATION RECHERCHE WEB
# ============================

# Clé API pour la recherche web (optionnel)
# Exemple : Google Search API
SEARCH_API_KEY=xxxxxxxxxxxxxxxxxxxxx

# ============================
# CONFIGURATION GENERALE
# ============================

# Mode de debug (true ou false)
DEBUG=false

# Langue par défaut
LANGUAGE=fr

# Timeout pour les requêtes (en secondes)
REQUEST_TIMEOUT=30
